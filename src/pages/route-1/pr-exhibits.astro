---
import { getCollection } from 'astro:content';
import Gallery from '../../layouts/Gallery.astro';
import { fmtDate } from '../../data/site';

const prs = (await getCollection('prs')).sort((a, b) => b.data.opened.getTime() - a.data.opened.getTime());
const merged = prs.filter((p) => p.data.status === 'merged').length;
const areas = [
  { key: 'PowerPC', label: 'PowerPC backend', where: 'at IBM' },
  { key: 'AMDGPU', label: 'AMDGPU backend', where: 'at AMD' },
  { key: 'Clang', label: 'Clang frontend', where: '' },
] as const;
---
<Gallery gallery="pr-exhibits" count={`${prs.length} PRs · ${merged} merged`} lede="Every upstream pull request to llvm/llvm-project, with its label.">
  <div class="gbody groups">
    {areas.map((a) => {
      const list = prs.filter((p) => p.data.area === a.key);
      if (!list.length) return null;
      return (
        <section>
          <h2><span class="ww">{a.label}</span>{a.where && <span class="where">{a.where}</span>}</h2>
          <ol class="prs">
            {list.map((p) => (
              <li>
                <a href={p.data.url} target="_blank" rel="noopener">
                  <span class="wl">
                    <b>{p.data.title}</b>
                    {p.data.note && <span>{p.data.note}</span>}
                    <span class="g">
                      #{p.id} · opened {fmtDate(p.data.opened)}
                      {p.data.merged && ` · merged ${fmtDate(p.data.merged)}`}
                    </span>
                  </span>
                  <span class:list={['status', p.data.status]}>{p.data.status}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      );
    })}
  </div>
</Gallery>

<style>
  .groups { display: flex; flex-direction: column; gap: 44px; }
  h2 { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin-bottom: 12px; }
  h2 .ww { font-size: clamp(1.8rem, 3.6vw, 2.6rem); }
  section:hover h2 .ww { font-variation-settings: 'wdth' var(--ww-hover); }
  .where { font: 500 .66rem/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ink2); }
  .prs { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .prs a { display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; padding: 14px 0; border-bottom: 1px solid var(--hair); }
  .prs a:hover .wl b { color: var(--plum); }
  .status { font: 500 .64rem/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; padding: 5px 8px; border-radius: 999px; white-space: nowrap; border: 1px solid currentColor; }
  .status.merged { color: var(--sage); }
  .status.open { color: var(--ochre); }
  .status.closed { color: var(--ink2); }
</style>
