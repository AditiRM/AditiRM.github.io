---
import Gallery from '../../layouts/Gallery.astro';
import { site } from '../../data/site';

// Everything on this page comes from the lists below. Edit them to update the résumé.
// The phone number from the PDF is deliberately not published here.

const experience = [
  {
    org: 'IBM',
    role: 'LLVM Compiler Engineer',
    when: 'Jan 2025 – present',
    where: 'Bengaluru',
    points: [
      'Implemented and upstreamed PowerPC BCD builtins in LLVM, from Clang semantic analysis to LLVM IR intrinsic definitions for AIX and Linux targets.',
      'Improved builtin correctness and diagnostics by extending constant-argument range validation and signed-overflow (saddoverflow) handling.',
      'Contributed to internal computer-architecture learning initiatives through technical discussions and knowledge sharing on low-level design and performance.',
    ],
  },
  {
    org: 'AMD',
    role: 'GPU Compiler Engineer',
    when: 'Aug 2022 – Dec 2024',
    where: 'Bengaluru',
    points: [
      'Contributed to the upstream LLVM AMDGPU backend, strengthening the MachineVerifier pass to catch illegal VGPR-to-SGPR copies and source–destination size mismatches, with multiple PRs merged.',
      'Worked with ML library teams (rocBLAS, rocRAND, rocPRIM, PyTorch) and HPC application teams to resolve performance bottlenecks, build failures and test failures caused by AMDGPU compiler compatibility.',
      'Proposed and presented SWIGGLE at the AMD Innovation Expo: a low-code/no-code platform that makes GPU computing more accessible through AMDGPU optimisations in ROCm.',
    ],
  },
  {
    org: 'Indian Institute of Technology, Hyderabad',
    role: 'Summer Research Fellow',
    when: 'Jul 2021',
    where: 'Hyderabad',
    points: [
      'Attended the ACM Summer School 2021 on Programming Languages Analysis and Optimizations: advanced compiler design and the LLVM compiler infrastructure.',
    ],
  },
];

const projects = [
  { name: 'ANTLP: ANother Tool for Lexer & Parser Generator', kind: 'Compiler construction', when: 'Aug 2021', what: 'A context-free grammar, lexer and recursive-descent parser for a C-like language, written in Go.', url: 'https://github.com/AditiRM/ANTLP' },
  { name: 'Userland multithreading library', kind: 'Operating systems', when: 'Apr 2021', what: 'A lightweight C library supporting both one-to-one and many-to-one threading models.' },
  { name: 'CO-convo-EP', kind: 'Progressive web app', when: 'Feb 2021', what: 'A secure chat application for educational institutions, built on the MERN stack.', url: 'https://gitlab.com/TheCodingWizard-911/SE-Project' },
  { name: 'grep in C', kind: 'Data structures & algorithms', when: 'Nov 2019', what: 'The grep command-line utility, reimplemented in C for Linux: text search and pattern matching.', url: 'https://github.com/AditiRM/Mygrep' },
];

const education = [
  {
    org: 'College of Engineering Pune',
    role: 'B.Tech, Computer Engineering',
    when: '2018 – 2022',
    what: 'Coursework: Advanced Unix Programming, Compiler Construction, Multi-core Technology, Computer Architecture, Operating Systems.',
  },
];

const responsibility = [
  {
    org: 'COEP Webteam',
    role: 'Project Manager',
    when: 'Feb 2020 – Feb 2022',
    what: "Led the move of the college's official website to Drupal, handling system administration, database monitoring and database server operations.",
  },
];

const skills = [
  { group: 'Languages', items: ['C', 'C++', 'Python', 'LLVM IR', 'PowerPC assembly'] },
  { group: 'Compilers & systems', items: ['LLVM', 'Clang', 'GCC (familiar)', 'Compiler design', 'Code generation', 'Optimisation passes'] },
  { group: 'Architecture & HPC', items: ['PowerPC / AIX', 'Computer architecture', 'GPU basics', 'Parallel computing'] },
  { group: 'Tools', items: ['Git', 'Linux', 'gdb & LLVM tools', 'CMake / Make'] },
  { group: 'Familiar with', items: ['ML systems', 'CUDA / HIP basics', 'Performance optimisation'] },
];
---
<Gallery gallery="resume" lede="LLVM compiler engineer at IBM, previously GPU compilers at AMD.">
  <div class="gbody cv">
    <aside class="col side">
      <h2 class="label">Skills</h2>
      <dl class="skills">
        {skills.map((s) => (
          <div>
            <dt>{s.group}</dt>
            <dd>
              <ul class="chips">{s.items.map((i) => <li>{i}</li>)}</ul>
            </dd>
          </div>
        ))}
      </dl>
      {site.resumePdf && <a class="pdf" href={site.resumePdf}>Download the PDF →</a>}
      <p class="more">Every upstream contribution is in <a href="/route-1/pr-exhibits/">PR Exhibits</a>.</p>
    </aside>

    <div class="col wide">
      <h2 class="label">Experience</h2>
      <ol class="rows">
        {experience.map((x) => (
          <li>
            <span class="when">{x.when}</span>
            <div class="what">
              <span class="wl"><b>{x.org}</b><span>{x.role} · {x.where}</span></span>
              <ul class="points">{x.points.map((p) => <li>{p}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>

      <h2 class="label">Projects</h2>
      <ol class="rows">
        {projects.map((p) => (
          <li>
            <span class="when">{p.when}</span>
            <div class="what">
              <span class="wl">
                <b>{p.name}</b>
                <span class="g">{p.kind}</span>
              </span>
              <p class="desc">
                {p.what}
                {p.url && <> <a class="code" href={p.url} target="_blank" rel="noopener">Code →</a></>}
              </p>
            </div>
          </li>
        ))}
      </ol>

      <h2 class="label">Education</h2>
      <ol class="rows">
        {education.map((x) => (
          <li>
            <span class="when">{x.when}</span>
            <div class="what">
              <span class="wl"><b>{x.org}</b><span>{x.role}</span></span>
              <p class="desc">{x.what}</p>
            </div>
          </li>
        ))}
      </ol>

      <h2 class="label">Positions of responsibility</h2>
      <ol class="rows">
        {responsibility.map((x) => (
          <li>
            <span class="when">{x.when}</span>
            <div class="what">
              <span class="wl"><b>{x.org}</b><span>{x.role}</span></span>
              <p class="desc">{x.what}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</Gallery>

<style>
  .cv { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.75fr); gap: clamp(24px, 5vw, 72px); align-items: start; }
  .col { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .side { position: sticky; top: 16px; }
  .wide .label:not(:first-child) { margin-top: 28px; }
  .skills { margin: 0; display: flex; flex-direction: column; gap: 16px; }
  .skills dt { font: 500 .64rem/1.4 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink2); margin-bottom: 6px; }
  .skills dd { margin: 0; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .chips li { border: 1px solid var(--plum); color: var(--plum); border-radius: 999px; padding: 3px 10px; font-size: .82rem; }
  .pdf { font: 500 .85rem/1 var(--mono); border-bottom: 1px solid var(--ink); align-self: flex-start; padding-bottom: 3px; margin-top: 8px; }
  .more { font: 400 .98rem/1.5 var(--serif); color: var(--ink2); margin-top: 8px; }
  .more a { color: var(--ink); border-bottom: 1px solid var(--hair); }
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .rows > li { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 18px; padding: 16px 0; border-bottom: 1px solid var(--hair); }
  .when { font: 400 .78rem/1.7 var(--mono); color: var(--ink2); font-variant-numeric: tabular-nums; }
  .what { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .points { margin: 0; padding-left: 1.1em; display: flex; flex-direction: column; gap: 6px; font-size: .92rem; line-height: 1.55; }
  .points li::marker { color: var(--plum); }
  .desc { font-size: .92rem; line-height: 1.55; }
  .code { font: 500 .78rem/1 var(--mono); color: var(--plum); border-bottom: 1px solid currentColor; white-space: nowrap; }
  .code:hover { color: var(--accent); }
  @media (max-width: 820px) { .cv { grid-template-columns: 1fr; } .side { position: static; } }
  @media (max-width: 560px) { .rows > li { grid-template-columns: 1fr; gap: 6px; } }
</style>
